{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "templating": {
    "list": [
      {
        "name": "traceId",
        "label": "Trace ID",
        "type": "textbox",
        "current": { "value": "", "text": "" },
        "options": [],
        "query": "",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Traces",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Recent Traces",
      "description": "Click a Trace ID to filter logs and view the trace waterfall and correlated logs below. Status shows ERROR (red) if any span in the trace has error status.",
      "type": "table",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "tempo-infinity" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "type": "uql",
          "source": "url",
          "format": "table",
          "url": "http://tempo:3200/api/search",
          "url_options": {
            "method": "GET",
            "params": [
              { "key": "q", "value": "{}" },
              { "key": "limit", "value": "20" },
              { "key": "start", "value": "${__from:date:seconds}" },
              { "key": "end", "value": "${__to:date:seconds}" }
            ]
          },
          "uql": "parse-json\n| scope \"traces\"\n| project \"Trace ID\"=\"traceID\", \"Start time\"=unixtime_nanoseconds_todatetime(\"startTimeUnixNano\"), \"Service\"=\"rootServiceName\", \"Name\"=\"rootTraceName\", \"Duration (ms)\"=\"durationMs\"",
          "parser": "uql"
        },
        {
          "refId": "B",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://tempo:3200/api/search",
          "url_options": {
            "method": "GET",
            "params": [
              { "key": "q", "value": "{status=error}" },
              { "key": "limit", "value": "100" },
              { "key": "start", "value": "${__from:date:seconds}" },
              { "key": "end", "value": "${__to:date:seconds}" }
            ]
          },
          "root_selector": "traces",
          "columns": [
            { "selector": "traceID", "text": "Trace ID", "type": "string" },
            { "selector": "traceID", "text": "Status", "type": "string" }
          ],
          "parser": "backend"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Trace ID",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Trace ID": 0,
              "Start time A": 1,
              "Service A": 2,
              "Name A": 3,
              "Duration (ms) A": 4,
              "Status B": 5
            },
            "renameByName": {
              "Start time A": "Start time",
              "Service A": "Service",
              "Name A": "Name",
              "Duration (ms) A": "Duration (ms)",
              "Status B": "Status"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Trace ID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Filter logs by this trace",
                    "url": "/d/trace-to-logs-explorer/trace-to-logs-explorer?var-traceId=${__value.text}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Start time" },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duration (ms)" },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": { "text": "OK", "color": "green", "index": 0 }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "empty",
                      "result": { "text": "OK", "color": "green", "index": 1 }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".+",
                      "result": { "text": "ERROR", "color": "red", "index": 2 }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      }
    },
    {
      "type": "row",
      "title": "Trace Detail",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false
    },
    {
      "title": "Trace Waterfall — $traceId",
      "description": "Full span waterfall for the selected trace. Select a trace from the table above.",
      "type": "traces",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "queryType": "traceql",
          "query": "${traceId}",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "type": "row",
      "title": "Correlated Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false
    },
    {
      "title": "Logs — ${traceId:text:All Traces}",
      "description": "When a trace is selected, only logs belonging to that trace are shown. Otherwise all correlated logs are displayed.",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=~\".+\"} | trace_id = `$traceId`",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": ["opentelemetry", "traces", "logs", "correlation"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Trace-to-Logs Explorer",
  "uid": "trace-to-logs-explorer",
  "version": 1
}
