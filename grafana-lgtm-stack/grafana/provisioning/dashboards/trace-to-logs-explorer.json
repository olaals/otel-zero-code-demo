{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "templating": {
    "list": [
      {
        "name": "traceId",
        "label": "Trace ID",
        "type": "textbox",
        "current": { "value": "", "text": "" },
        "options": [],
        "query": "",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Traces",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Recent Traces",
      "description": "Click a Trace ID to filter logs and view trace details below.",
      "type": "table",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "targets": [
        {
          "queryType": "traceqlSearch",
          "refId": "A",
          "limit": 20,
          "tableType": "traces",
          "filters": [
            {
              "id": "service-name",
              "tag": "service.name",
              "scope": "resource",
              "operator": "=",
              "value": [],
              "valueType": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Trace ID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Filter logs by this trace",
                    "url": "/d/trace-to-logs-explorer/trace-to-logs-explorer?var-traceId=${__value.text}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          { "displayName": "Start time", "desc": true }
        ]
      }
    },
    {
      "type": "row",
      "title": "Trace Detail",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false
    },
    {
      "title": "Trace Waterfall — $traceId",
      "description": "Full span waterfall for the selected trace. Select a trace from the table above.",
      "type": "traces",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "queryType": "traceql",
          "query": "${traceId}",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "type": "row",
      "title": "Correlated Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false
    },
    {
      "title": "Logs — ${traceId:text:All Traces}",
      "description": "When a trace is selected, only logs belonging to that trace are shown. Otherwise all correlated logs are displayed.",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=~\".+\"} | trace_id = `$traceId`",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": ["opentelemetry", "traces", "logs", "correlation"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Trace-to-Logs Explorer",
  "uid": "trace-to-logs-explorer",
  "version": 1
}
