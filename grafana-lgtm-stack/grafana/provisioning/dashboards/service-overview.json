{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Service Map",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Service Map",
      "description": "Interactive graph of service dependencies derived from trace data. Nodes represent services, edges represent calls between them.",
      "type": "nodeGraph",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "targets": [
        {
          "queryType": "serviceMap",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "RED Metrics (Rate / Errors / Duration)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false
    },
    {
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "datasource": { "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "pointSize": 5,
            "showPoints": "auto"
          },
          "color": { "mode": "fixed" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "weatherwatch" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#007079" } }] },
          { "matcher": { "id": "byName", "options": "activity-recommender" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9200" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "sum by(service) (rate(traces_spanmetrics_calls_total[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Error Rate (%)",
      "type": "timeseries",
      "datasource": { "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "pointSize": 5,
            "showPoints": "auto"
          },
          "color": { "mode": "fixed" },
          "min": 0,
          "max": 1
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "weatherwatch" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#007079" } }] },
          { "matcher": { "id": "byName", "options": "activity-recommender" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9200" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "sum by(service) (rate(traces_spanmetrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[1m])) / sum by(service) (rate(traces_spanmetrics_calls_total[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "P95 Latency",
      "type": "timeseries",
      "datasource": { "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "pointSize": 5,
            "showPoints": "auto"
          },
          "color": { "mode": "fixed" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "weatherwatch" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#007079" } }] },
          { "matcher": { "id": "byName", "options": "activity-recommender" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9200" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(service, le) (rate(traces_spanmetrics_latency_bucket[1m])))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Per-Endpoint Breakdown",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "collapsed": false
    },
    {
      "title": "Request Rate by Endpoint",
      "type": "timeseries",
      "datasource": { "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 50,
            "stacking": { "mode": "normal" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "sum"] }
      },
      "targets": [
        {
          "expr": "sum by(service, span_name) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[1m]))",
          "legendFormat": "{{service}} :: {{span_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Latency by Endpoint (P50 / P95 / P99)",
      "type": "timeseries",
      "datasource": { "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by(service, span_name, le) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[1m])))",
          "legendFormat": "p50 {{service}} :: {{span_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by(service, span_name, le) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[1m])))",
          "legendFormat": "p95 {{service}} :: {{span_name}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(service, span_name, le) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[1m])))",
          "legendFormat": "p99 {{service}} :: {{span_name}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "Service Map & Traces",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false
    },
    {
      "title": "Service-to-Service Request Rate",
      "type": "timeseries",
      "datasource": { "uid": "mimir" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "pointSize": 5,
            "showPoints": "auto"
          },
          "color": { "mode": "fixed" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "user -> weatherwatch" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#007079" } }] },
          { "matcher": { "id": "byName", "options": "weatherwatch -> activity-recommender" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9200" } }] },
          { "matcher": { "id": "byName", "options": "weatherwatch -> db" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#6F6F6F" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "sum by(client, server) (rate(traces_service_graph_request_total[5m]))",
          "legendFormat": "{{client}} -> {{server}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Recent Traces",
      "type": "table",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 30 },
      "targets": [
        {
          "queryType": "traceqlSearch",
          "limit": 20,
          "filters": [
            { "id": "span-kind", "tag": "kind", "operator": "=", "value": ["server"], "scope": "intrinsic" }
          ],
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["weatherwatch", "otel"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Service Overview",
  "uid": "service-overview",
  "version": 1
}
